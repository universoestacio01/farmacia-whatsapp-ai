NODE_ENV=development
IGNORE_ENV_FILE=false
PORT=3000
APP_URL="https://seudominio.com.br"
ADMIN_TOKEN=""

# MySQL
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/farmacia_whatsapp_ai"

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN="troque-este-token"
WHATSAPP_ACCESS_TOKEN="EAAB..."
WHATSAPP_PHONE_NUMBER_ID="1234567890"
WHATSAPP_APP_SECRET="app-secret-da-meta"
WHATSAPP_API_VERSION="v25.0"

# OpenAI
# Optional: OPENAI_VISION_MODEL selects the model used to read package photos.
# Without OPENAI_API_KEY, the bot asks for the product name and dosage in text.
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Integracoes externas
# Primary catalog, at full Price. Backups apply to medicines only.
PRECO_POPULAR_ENABLED=true
# Prices follow the catalog's Price field without any extra discount.
# PRECO_POPULAR_PRICE_MULTIPLIER is retired and ignored.
PHARMADB_ENABLED=true
PHARMADB_API_KEY=""
PHARMADB_API_BASE_URL="https://api.pharmadb.com.br/v1"
# PharmaDB: PF first; otherwise PMC * 0.5, as in the former rule.
PHARMADB_PMC_PRICE_MULTIPLIER=0.5
BULAPI_ENABLED=true
BULA_API_BASE_URL="https://bulapi.com.br/api/v1"
# BulAPI: highest PF of the exact presentation. No invented price.
VIACEP_BASE_URL="https://viacep.com.br/ws"

# Pix direto com valor gerado por pedido
PIX_PROVIDER="pix_direct"
PIX_KEY="c9d7eec2-539a-4d7a-86ec-078d2abf4d75"
PIX_MERCHANT_NAME="RAIA FARMACIA"
PIX_MERCHANT_CITY="SAO PAULO"

